Criando tabela HOTEL:

CREATE TABLE hotel(
    id_hotel INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    cnpj VARCHAR(18) UNIQUE,
    telefone VARCHAR(20),
    email VARCHAR(150),
    endereco VARCHAR(200) NOT NULL,
    cidade VARCHAR(100) NOT NULL,
    estado CHAR(2) NOT NULL,
    cep VARCHAR(10) NOT NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE
);

Criando tabela TIPO_QUARTO:

CREATE TABLE tipo_quarto(
    id_tipo_quarto INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_hotel INTEGER NOT NULL,
    nome VARCHAR(80) NOT NULL,
    descricao TEXT,
    capacidade INTEGER NOT NULL CHECK(capacidade > 0),
    preco_diaria NUMERIC(10,2) NOT NULL CHECK(preco_diaria >= 0),
    
    CONSTRAINT fk_tipo_hotel
        FOREIGN KEY (id_hotel) REFERENCES hotel(id_hotel),
        
        CONSTRAINT uq_tipo_nome_hotel
            UNIQUE (id_hotel, nome),
    
        CONSTRAINT up_tipo_hotel
            UNIQUE (id_tipo_quarto, id_hotel)
);

Criando tabela QUARTO:


CREATE TABLE quarto (
    id_quarto INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_hotel INTEGER NOT NULL,
    id_tipo_quarto INTEGER NOT NULL,
    numero VARCHAR(10) NOT NULL,
    andar INTEGER,
    status VARCHAR(20) NOT NULL DEFAULT 'disponivel'
        CHECK (status IN (
            'disponivel',
            'manutencao',
            'inativo'
        )),

    CONSTRAINT fk_quarto_tipo_hotel
        FOREIGN KEY (id_tipo_quarto, id_hotel)
        REFERENCES tipo_quarto(id_tipo_quarto, id_hotel),

    CONSTRAINT uq_quarto_numero_hotel
        UNIQUE (id_hotel, numero)
);

Criando tabela HÓSPEDE:

CREATE TABLE hospede(
    id_hospede INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    cpf VARCHAR(14) UNIQUE,
    email VARCHAR(150),
    telefone VARCHAR(20),
    data_nascimento DATE,
    criado_em TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

Criando tabela USUÁRIO:


CREATE TABLE usuario(
    id_usuario INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE, 
    senha_hash TEXT NOT NULL,
    perfil VARCHAR(20) NOT NULL
        CHECK (perfil IN(
        'administrador',
        'recepcionista',
        'gerente')),
    ativo BOOLEAN NOT NULL DEFAULT TRUE,
    criado_em TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

Criando a tabela RESERVA:

CREATE TABLE reserva (
    id_reserva INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_hospede INTEGER NOT NULL,
    data_reserva TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    checkin_previsto DATE NOT NULL,
    checkout_previsto DATE NOT NULL,
    quantidade_hospedes INTEGER NOT NULL
        CHECK (quantidade_hospedes > 0),
    status VARCHAR(20) NOT NULL DEFAULT 'pendente'
        CHECK (status IN (
            'pendente',
            'confirmada',
            'cancelada',
            'concluida',
            'nao_compareceu'
        )),
    valor_total NUMERIC(12,2) NOT NULL DEFAULT 0
        CHECK (valor_total >= 0),
    observacoes TEXT,

    CONSTRAINT fk_reserva_hospede
        FOREIGN KEY (id_hospede) REFERENCES hospede(id_hospede),

    CONSTRAINT ck_datas_reserva
        CHECK (checkout_previsto > checkin_previsto)
);

CREATE TABLE reserva_quarto (
    id_reserva_quarto INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_reserva INTEGER NOT NULL,
    id_quarto INTEGER NOT NULL,
    valor_diaria NUMERIC(10,2) NOT NULL
        CHECK (valor_diaria >= 0),
    quantidade_diarias INTEGER NOT NULL
        CHECK (quantidade_diarias > 0),
    valor_total NUMERIC(12,2) NOT NULL
        CHECK (valor_total >= 0),

    CONSTRAINT fk_rq_reserva
        FOREIGN KEY (id_reserva) REFERENCES reserva(id_reserva),

    CONSTRAINT fk_rq_quarto
        FOREIGN KEY (id_quarto) REFERENCES quarto(id_quarto),

    CONSTRAINT uq_reserva_quarto
        UNIQUE (id_reserva, id_quarto)
);

Criando tabela HOSPEDAGEM:

CREATE TABLE hospedagem (
    id_hospedagem INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_reserva_quarto INTEGER NOT NULL UNIQUE,
    id_usuario_checkin INTEGER,
    id_usuario_checkout INTEGER,
    checkin_real TIMESTAMPTZ,
    checkout_real TIMESTAMPTZ,
    observacoes TEXT,

    CONSTRAINT fk_hospedagem_reserva_quarto
        FOREIGN KEY (id_reserva_quarto)
        REFERENCES reserva_quarto(id_reserva_quarto),

    CONSTRAINT fk_hospedagem_usuario_checkin
        FOREIGN KEY (id_usuario_checkin)
        REFERENCES usuario(id_usuario),

    CONSTRAINT fk_hospedagem_usuario_checkout
        FOREIGN KEY (id_usuario_checkout)
        REFERENCES usuario(id_usuario),

    CONSTRAINT ck_hospedagem_datas
        CHECK (
            checkout_real IS NULL
            OR (
                checkin_real IS NOT NULL
                AND checkout_real >= checkin_real
            )
        )
);

Criando tabela PAGAMENTO:

CREATE TABLE pagamento (
    id_pagamento INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_reserva INTEGER NOT NULL,
    valor NUMERIC(12,2) NOT NULL CHECK (valor > 0),
    metodo VARCHAR(20) NOT NULL
        CHECK (metodo IN (
            'pix',
            'credito',
            'debito',
            'dinheiro',
            'transferencia'
        )),
    status VARCHAR(20) NOT NULL DEFAULT 'pendente'
        CHECK (status IN (
            'pendente',
            'aprovado',
            'recusado',
            'estornado'
        )),
    codigo_transacao VARCHAR(150),
    pago_em TIMESTAMPTZ,
    criado_em TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_pagamento_reserva
        FOREIGN KEY (id_reserva) REFERENCES reserva(id_reserva)
);

Criando tabela MANUTENCAO

CREATE TABLE manutencao (
    id_manutencao INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_quarto INTEGER NOT NULL,
    id_usuario INTEGER,
    data_inicio TIMESTAMPTZ NOT NULL,
    data_fim TIMESTAMPTZ,
    motivo TEXT NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'aberta'
        CHECK (status IN (
            'aberta',
            'em_andamento',
            'concluida',
            'cancelada'
        )),

    CONSTRAINT fk_manutencao_quarto
        FOREIGN KEY (id_quarto) REFERENCES quarto(id_quarto),

    CONSTRAINT fk_manutencao_usuario
        FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario),

    CONSTRAINT ck_manutencao_datas
        CHECK (data_fim IS NULL OR data_fim > data_inicio)
);

Criando tabela historico_reserva:

CREATE TABLE historico_reserva (
    id_historico INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    id_reserva INTEGER NOT NULL,
    id_usuario INTEGER,
    status_anterior VARCHAR(20),
    status_novo VARCHAR(20) NOT NULL,
    alterado_em TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    observacao TEXT,

    CONSTRAINT fk_historico_reserva
        FOREIGN KEY (id_reserva) REFERENCES reserva(id_reserva),

    CONSTRAINT fk_historico_usuario
        FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario)
);


<?php
require_once 'config.php';

$mensagemErro = '';

$idHospede = '';
$idQuarto = '';
$checkin = '';
$checkout = '';
$quantidade = '';

$hoteis = $pdo->query("
    SELECT * FROM hotel ORDER BY id_hotel
")->fetchAll();

$quartos = $pdo->query("
    SELECT
        q.*,
        t.nome AS tipo_quarto,
        t.preco_diaria,
        t.capacidade
    FROM quarto q
    JOIN tipo_quarto t
        ON q.id_tipo_quarto = t.id_tipo_quarto
    ORDER BY q.numero
")->fetchAll();

$hospedes = $pdo->query("
    SELECT * FROM hospede ORDER BY nome
")->fetchAll();

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $idHospede = $_POST['id_hospede'] ?? '';
    $idQuarto = $_POST['id_quarto'] ?? '';
    $checkin = $_POST['checkin'] ?? '';
    $checkout = $_POST['checkout'] ?? '';
    $quantidade = $_POST['quantidade_hospedes'] ?? '';

    $quantidadeInt = filter_var($quantidade, FILTER_VALIDATE_INT);

    // Validação das datas
    if (
        !$checkin ||
        !$checkout ||
        strtotime($checkout) <= strtotime($checkin)
    ) {
        $mensagemErro = 'A data do check-out deve ser posterior à data do check-in.';
    }

    // Validação da quantidade de hóspedes
    elseif (!$quantidadeInt || $quantidadeInt < 1) {
        $mensagemErro = 'Informe uma quantidade válida de hóspedes.';
    }

    else {
        $dias = (strtotime($checkout) - strtotime($checkin)) / 86400;

        $stmt = $pdo->prepare("
            SELECT
                q.id_quarto,
                t.preco_diaria,
                t.capacidade
            FROM quarto q
            JOIN tipo_quarto t
                ON q.id_tipo_quarto = t.id_tipo_quarto
            WHERE q.id_quarto = ?
        ");

        $stmt->execute([$idQuarto]);
        $quarto = $stmt->fetch();

        if (!$quarto) {
            $mensagemErro = 'Quarto inválido. Selecione um quarto disponível.';
        }

        elseif ($quantidadeInt > $quarto['capacidade']) {
            $mensagemErro = 'Capacidade excedida! Este quarto comporta no máximo '
                . $quarto['capacidade'] . ' hóspede(s).';
        }

        else {
            // Verifica conflitos de reservas
            $stmt = $pdo->prepare("
                SELECT COUNT(*)
                FROM reserva r
                JOIN reserva_quarto rq
                    ON r.id_reserva = rq.id_reserva
                WHERE rq.id_quarto = ?
                AND r.status IN ('pendente', 'confirmada')
                AND r.checkin_previsto < ?
                AND r.checkout_previsto > ?
            ");

            $stmt->execute([
                $idQuarto,
                $checkout,
                $checkin
            ]);

            if ($stmt->fetchColumn() > 0) {
                $mensagemErro = 'Quarto indisponível para o período selecionado.';
            }

            else {
                $valorTotal = $quarto['preco_diaria'] * $dias;

                try {
                    $pdo->beginTransaction();

                    $stmt = $pdo->prepare("
                        INSERT INTO reserva (
                            id_hospede,
                            data_reserva,
                            checkin_previsto,
                            checkout_previsto,
                            quantidade_hospedes,
                            status,
                            valor_total
                        )
                        VALUES (?, CURRENT_DATE, ?, ?, ?, 'pendente', ?)
                        RETURNING id_reserva
                    ");

                    $stmt->execute([
                        $idHospede,
                        $checkin,
                        $checkout,
                        $quantidadeInt,
                        $valorTotal
                    ]);

                    $idReserva = $stmt->fetchColumn();

                    $stmt = $pdo->prepare("
                        INSERT INTO reserva_quarto (
                            id_reserva,
                            id_quarto,
                            valor_diaria,
                            quantidade_diarias,
                            valor_total
                        )
                        VALUES (?, ?, ?, ?, ?)
                    ");

                    $stmt->execute([
                        $idReserva,
                        $idQuarto,
                        $quarto['preco_diaria'],
                        $dias,
                        $valorTotal
                    ]);

                    $stmt = $pdo->prepare("
                        INSERT INTO historico_reserva (
                            id_reserva,
                            status_anterior,
                            status_novo,
                            observacao
                        )
                        VALUES (?, NULL, 'pendente', 'Reserva criada')
                    ");

                    $stmt->execute([$idReserva]);

                    $pdo->commit();

                    header("Location: index.php#reservas");
                    exit;

                } catch (Exception $e) {
                    if ($pdo->inTransaction()) {
                        $pdo->rollBack();
                    }

                    $mensagemErro = 'Não foi possível criar a reserva. Verifique os dados e tente novamente.';
                }
            }
        }
    }
}

// Consultas para exibição
$reservas = $pdo->query("
